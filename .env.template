# Environment Template
# Copy to backend/.env and fill in your values

# ═══════════════════════════════════════════════════════════
# EXTERNAL SERVICES (Get free API keys)
# ═══════════════════════════════════════════════════════════

# Supabase (Database) — Sign up at https://supabase.com
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGc...your_key_here

# Groq (Free LLM API) — Sign up at https://console.groq.com
# Free tier: Unlimited requests, rate limited to ~100req/min
GROQ_API_KEY=gsk_...your_key_here


# ═══════════════════════════════════════════════════════════
# MODEL CONFIGURATION (Swap models by changing these)
# ═══════════════════════════════════════════════════════════

# LLM Model — any Groq-supported model ID
# Examples: "llama-3.1-8b-instant", "llama-3.3-70b-versatile", "openai/gpt-oss-120b"
LLM_MODEL_NAME=openai/gpt-oss-120b

# Embedding Model — Always use local (no API calls)
# IMPORTANT: Must match the DB column dimension (768).
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5

# Reranker Model — Always use local (no API calls)
RERANKER_MODEL_NAME=Xenova/ms-marco-MiniLM-L-12-v2

# Maximum tokens in the LLM response
LLM_MAX_OUTPUT_TOKENS=2048

# ═══════════════════════════════════════════════════════════
# RETRIEVAL SETTINGS
# ═══════════════════════════════════════════════════════════

# How many documents to retrieve initially before reranking
RETRIEVAL_TOP_K=50

# How many top documents to keep after reranking
RERANKER_TOP_K=10

# Minimum relevance score (0.0-1.0) to include documents
MIN_RELEVANCE_SCORE=0.20

# Fallback threshold if too few results survive (0.0-1.0)
MIN_RELEVANCE_SCORE_LOW=0.05

# Minimum score the TOP retrieved document must reach before the assistant
# is allowed to answer. Prevents off-topic or hallucinated answers.
# Keep this >= MIN_RELEVANCE_SCORE_LOW.
ANSWER_MIN_RELEVANCE_SCORE=0.12

# Cosine similarity at or below this value maps to relevance 0
# when no reranker score is available (fallback scale alignment).
EMBEDDING_SCORE_FLOOR=0.5

# ═══════════════════════════════════════════════════════════
# ADVANCED RAG FEATURES
# ═══════════════════════════════════════════════════════════

# Query Rewriting
# Resolves pronouns in multi-turn conversation
# Impact: +0.5 seconds, +1 LLM call
ENABLE_QUERY_REWRITE=false

# Neighbor Context Expansion
# Fetches sibling chunks from the same parent section
# Impact: +0.2-0.5 seconds, +multiple DB queries
ENABLE_NEIGHBOR_CONTEXT=false

# Top hits that get neighbor-chunk expansion
MAX_EXPAND_DOCS=5

# Character cap per neighbor chunk pulled in
MAX_NEIGHBOR_CHARS=1500

# How often a box's BM25 index is checked against the DB (seconds)
LEXICAL_INDEX_FRESHNESS_SECONDS=30

# Log per-chunk reranker scores and dropped chunks (useful for debugging)
ENABLE_RERANK_DEBUG_LOGGING=false

# ═══════════════════════════════════════════════════════════
# CITATION FIREWALL
# ═══════════════════════════════════════════════════════════

# 'soft' reports unsupported claims in metadata; 'strict' removes them
CITATION_ENFORCEMENT_MODE=soft

# Cross-encoder threshold for sentence-level support
CITATION_SUPPORT_THRESHOLD=0.3

# ═══════════════════════════════════════════════════════════
# INGESTION SETTINGS
# ═══════════════════════════════════════════════════════════

# Document chunk size (for semantic splitting)
CHUNK_SIZE=1400

# Overlap between chunks
CHUNK_OVERLAP=200

# How many chunks to embed in parallel (smaller = less memory, more time)
INGESTION_BATCH_SIZE=32

# Maximum size of a single uploaded file in megabytes
MAX_UPLOAD_SIZE_MB=25

# DOCX/XLSX are zip archives: cap their unpacked size (zip-bomb guard)
MAX_UNCOMPRESSED_UPLOAD_MB=200

# Ingestion backpressure: jobs embedding at once / uploads waiting before new ones get 429
MAX_CONCURRENT_INGESTIONS=2
MAX_PENDING_INGESTIONS=10

# A document still 'processing' after this many minutes is marked failed
STALE_PROCESSING_MINUTES=60

# ═══════════════════════════════════════════════════════════
# RATE LIMITING (per signed-in user)
# ═══════════════════════════════════════════════════════════

# Format: "requests/time_period"
# Examples: "20/minute", "100/hour", "1000/day"
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_UPLOAD=10/minute
# Box/session create, rename and delete
RATE_LIMIT_WRITE=30/minute

# Per-user abuse quotas
MAX_BOXES_PER_USER=50
MAX_DOCUMENTS_PER_BOX=200
MAX_QUESTION_CHARS=4000

# ═══════════════════════════════════════════════════════════
# CORS CONFIGURATION
# ═══════════════════════════════════════════════════════════

# Comma-separated list of allowed origins.
# Example: CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000

# Swagger UI at /docs and the OpenAPI schema. Keep false in production.
ENABLE_API_DOCS=false

# ═══════════════════════════════════════════════════════════
# API TIMEOUTS & RESILIENCE
# ═══════════════════════════════════════════════════════════

# Timeout for external API calls (seconds)
REQUEST_TIMEOUT=120

# Max retry attempts for LLM API failures
LLM_MAX_RETRIES=3

# Max retry attempts for Database failures
DB_MAX_RETRIES=3


# ═══════════════════════════════════════════════════════════
# FRONTEND (frontend/.env.local)
# ═══════════════════════════════════════════════════════════
# These go in frontend/.env.local, NOT in backend/.env
